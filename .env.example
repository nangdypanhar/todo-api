# Copy this file to .env and fill in the values: cp .env.example .env

# App
PORT=3000
# Host port docker-compose publishes the API on (defaults to 3000)
API_PORT=3000
NODE_ENV=development

# PostgreSQL (also used by docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nestuser
DB_PASSWORD=<your-password>
DB_DATABASE=todo-db

# Signs both access and refresh tokens. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=<random-secret>

# Redis (BullMQ queues, also used by docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
