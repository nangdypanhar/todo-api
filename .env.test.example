# Copy this file to .env.test for e2e tests: cp .env.test.example .env.test

# App
PORT=3000
NODE_ENV=test

# PostgreSQL (also used by docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nestuser
DB_PASSWORD=<your-password>
DB_DATABASE=mytasks_test

# Signs both access and refresh tokens. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=<random-secret>

# Redis (BullMQ queues, also used by docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Keeps test queue jobs apart from the dev server
BULLMQ_PREFIX=bull-test
